{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_management'|trans({}, 'messages', app.request.locale)|default('User Management') }}{% endblock %}

{% block body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>{{ 'title.user_management'|trans({}, 'messages', app.request.locale)|default('User Management') }}</h1>
        <a href="{{ path('admin_user_new') }}" style="padding: 0.5rem 1rem; background: #198754; color: white; text-decoration: none; border-radius: 0.25rem;">
            {{ 'action.create_user'|trans({}, 'messages', app.request.locale)|default('Create New User') }}
        </a>
    </div>

    {% if users|length > 0 %}
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; background: white; border: 1px solid #dee2e6;">
                <thead style="background: #f8f9fa;">
                    <tr>
                        <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid #dee2e6;">{{ 'label.username'|trans({}, 'messages', app.request.locale)|default('Username') }}</th>
                        <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid #dee2e6;">{{ 'label.fullname'|trans({}, 'messages', app.request.locale)|default('Full Name') }}</th>
                        <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid #dee2e6;">{{ 'label.email'|trans({}, 'messages', app.request.locale)|default('Email') }}</th>
                        <th style="padding: 0.75rem; text-align: left; border-bottom: 2px solid #dee2e6;">{{ 'label.roles'|trans({}, 'messages', app.request.locale)|default('Roles') }}</th>
                        <th style="padding: 0.75rem; text-align: center; border-bottom: 2px solid #dee2e6;">{{ 'label.actions'|trans({}, 'messages', app.request.locale)|default('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr style="border-bottom: 1px solid #dee2e6;">
                            <td style="padding: 0.75rem;">
                                <strong>{{ user.username }}</strong>
                                {% if app.user and app.user.id == user.id %}
                                    <span style="display: inline-block; padding: 0.25rem 0.5rem; background: #0d6efd; color: white; font-size: 0.75rem; border-radius: 0.25rem; margin-left: 0.5rem;">
                                        {{ 'label.current_user'|trans({}, 'messages', app.request.locale)|default('You') }}
                                    </span>
                                {% endif %}
                            </td>
                            <td style="padding: 0.75rem;">{{ user.fullName }}</td>
                            <td style="padding: 0.75rem;">{{ user.email }}</td>
                            <td style="padding: 0.75rem;">
                                {% for role in user.roles %}
                                    <span style="display: inline-block; padding: 0.25rem 0.5rem; background: {% if role == 'ROLE_ADMIN' %}#dc3545{% else %}#6c757d{% endif %}; color: white; font-size: 0.75rem; border-radius: 0.25rem; margin-right: 0.25rem;">
                                        {{ ('role.' ~ role|lower)|trans({}, 'messages', app.request.locale)|default(role) }}
                                    </span>
                                {% endfor %}
                            </td>
                            <td style="padding: 0.75rem; text-align: center;">
                                {% if app.user.id != user.id %}
                                    <a href="{{ path('blog_index', {'_switch_user': user.username}) }}"
                                       style="display: inline-block; padding: 0.375rem 0.75rem; background: #0d6efd; color: white; text-decoration: none; border-radius: 0.25rem;"
                                       onclick="return confirm('{{ 'confirm.login_as'|trans({'%username%': user.username}, 'messages', app.request.locale)|default('Login as ' ~ user.username ~ '?') }}')">
                                        {{ 'action.login_as'|trans({}, 'messages', app.request.locale)|default('Login As') }}
                                    </a>
                                {% else %}
                                    <span style="color: #6c757d; font-style: italic;">{{ 'label.current_session'|trans({}, 'messages', app.request.locale)|default('Current session') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div style="padding: 2rem; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 0.25rem; text-align: center;">
            <p style="margin: 0; color: #6c757d;">{{ 'help.no_users'|trans({}, 'messages', app.request.locale)|default('No users found.') }}</p>
        </div>
    {% endif %}

    <div style="margin-top: 2rem; padding: 1rem; background: #e7f1ff; border: 1px solid #084298; border-radius: 0.25rem;">
        <h3 style="margin-bottom: 0.5rem;">{{ 'title.info'|trans({}, 'messages', app.request.locale)|default('Information') }}</h3>
        <p style="margin: 0; color: #084298;">
            {{ 'help.login_as_feature'|trans({}, 'messages', app.request.locale)|default('Use the "Login As" feature to authenticate as any user for testing purposes. This is a demo feature.') }}
        </p>
    </div>
{% endblock %}
