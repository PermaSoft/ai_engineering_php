{% extends 'base.html.twig' %}

{% block title %}{{ 'title.edit_post'|trans({}, 'messages', app.request.locale)|default('Edit post') }}{% endblock %}

{% block body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>{{ 'title.edit_post'|trans({}, 'messages', app.request.locale)|default('Edit post') }}</h1>

        {% if is_granted('delete', post) %}
            <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" style="display: inline;" onsubmit="return confirm('{{ 'message.confirm_delete'|trans({}, 'messages', app.request.locale)|default('Are you sure you want to delete this post?') }}');">
                <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                <button type="submit" style="padding: 0.5rem 1rem; background: #dc3545; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">
                    {{ 'action.delete'|trans({}, 'messages', app.request.locale)|default('Delete') }}
                </button>
            </form>
        {% endif %}
    </div>

    {{ form_start(form) }}
        <div style="background: white; padding: 2rem; border-radius: 0.25rem; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
            {{ form_widget(form) }}

            <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
                <button type="submit" style="padding: 0.5rem 1.5rem; background: #0d6efd; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 1rem;">
                    {{ 'action.save'|trans({}, 'messages', app.request.locale)|default('Save changes') }}
                </button>

                <a href="{{ path('admin_post_index') }}" style="padding: 0.5rem 1.5rem; background: #6c757d; color: white; text-decoration: none; border-radius: 0.25rem; display: inline-block; font-size: 1rem;">
                    {{ 'action.cancel'|trans({}, 'messages', app.request.locale)|default('Cancel') }}
                </a>
            </div>
        </div>
    {{ form_end(form) }}

    <div style="margin-top: 1rem;">
        <small style="color: #6c757d;">
            {{ 'help.post_edit_note'|trans({}, 'messages', app.request.locale)|default('Last updated:') }}
            {{ post.publishedAt|date('Y-m-d H:i:s') }}
        </small>
    </div>
{% endblock %}
