{% extends 'base.html.twig' %}

{% block title %}{{ 'title.admin_post_index'|trans({}, 'messages', app.request.locale)|default('Post Management') }}{% endblock %}

{% block body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>{{ 'title.admin_post_index'|trans({}, 'messages', app.request.locale)|default('Post Management') }}</h1>
        <a href="{{ path('admin_post_new') }}" style="padding: 0.5rem 1rem; background: #0d6efd; color: white; text-decoration: none; border-radius: 0.25rem;">
            {{ 'action.create_post'|trans({}, 'messages', app.request.locale)|default('Create new post') }}
        </a>
    </div>

    {% if posts is empty %}
        <div style="padding: 2rem; text-align: center; background: #f8f9fa; border-radius: 0.25rem;">
            <p>{{ 'message.no_posts_found'|trans({}, 'messages', app.request.locale)|default('No posts found.') }}</p>
        </div>
    {% else %}
        <table style="width: 100%; border-collapse: collapse; background: white; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
            <thead>
                <tr style="background: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                    <th style="padding: 1rem; text-align: left;">{{ 'label.title'|trans({}, 'messages', app.request.locale)|default('Title') }}</th>
                    <th style="padding: 1rem; text-align: left;">{{ 'label.published_at'|trans({}, 'messages', app.request.locale)|default('Published at') }}</th>
                    <th style="padding: 1rem; text-align: left;">{{ 'label.author'|trans({}, 'messages', app.request.locale)|default('Author') }}</th>
                    <th style="padding: 1rem; text-align: center;">{{ 'label.actions'|trans({}, 'messages', app.request.locale)|default('Actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr style="border-bottom: 1px solid #dee2e6;">
                        <td style="padding: 1rem;">
                            <a href="{{ path('admin_post_show', {id: post.id}) }}" style="font-weight: 500; color: #0d6efd; text-decoration: none;">
                                {{ post.title }}
                            </a>
                        </td>
                        <td style="padding: 1rem;">{{ post.publishedAt|date('Y-m-d H:i') }}</td>
                        <td style="padding: 1rem;">{{ post.author.fullName }}</td>
                        <td style="padding: 1rem; text-align: center;">
                            <div style="display: flex; gap: 0.5rem; justify-content: center;">
                                <a href="{{ path('admin_post_show', {id: post.id}) }}" style="padding: 0.25rem 0.75rem; background: #6c757d; color: white; text-decoration: none; border-radius: 0.25rem; font-size: 0.875rem;">
                                    {{ 'action.view'|trans({}, 'messages', app.request.locale)|default('View') }}
                                </a>
                                {% if is_granted('edit', post) %}
                                    <a href="{{ path('admin_post_edit', {id: post.id}) }}" style="padding: 0.25rem 0.75rem; background: #0d6efd; color: white; text-decoration: none; border-radius: 0.25rem; font-size: 0.875rem;">
                                        {{ 'action.edit'|trans({}, 'messages', app.request.locale)|default('Edit') }}
                                    </a>
                                {% endif %}
                                {% if is_granted('delete', post) %}
                                    <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" style="display: inline;" onsubmit="return confirm('{{ 'message.confirm_delete'|trans({}, 'messages', app.request.locale)|default('Are you sure you want to delete this post?') }}');">
                                        <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                                        <button type="submit" style="padding: 0.25rem 0.75rem; background: #dc3545; color: white; border: none; border-radius: 0.25rem; font-size: 0.875rem; cursor: pointer;">
                                            {{ 'action.delete'|trans({}, 'messages', app.request.locale)|default('Delete') }}
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
