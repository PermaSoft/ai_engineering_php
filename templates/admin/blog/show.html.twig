{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h1>{{ post.title }}</h1>

        <div style="display: flex; gap: 0.5rem;">
            {% if is_granted('edit', post) %}
                <a href="{{ path('admin_post_edit', {id: post.id}) }}" style="padding: 0.5rem 1rem; background: #0d6efd; color: white; text-decoration: none; border-radius: 0.25rem;">
                    {{ 'action.edit'|trans({}, 'messages', app.request.locale)|default('Edit') }}
                </a>
            {% endif %}

            {% if is_granted('delete', post) %}
                <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" style="display: inline;" onsubmit="return confirm('{{ 'message.confirm_delete'|trans({}, 'messages', app.request.locale)|default('Are you sure you want to delete this post?') }}');">
                    <input type="hidden" name="token" value="{{ csrf_token('delete') }}">
                    <button type="submit" style="padding: 0.5rem 1rem; background: #dc3545; color: white; border: none; border-radius: 0.25rem; cursor: pointer;">
                        {{ 'action.delete'|trans({}, 'messages', app.request.locale)|default('Delete') }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div style="background: white; padding: 2rem; border-radius: 0.25rem; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
        <div style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #dee2e6;">
            <div style="display: grid; grid-template-columns: 150px 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                <strong>{{ 'label.author'|trans({}, 'messages', app.request.locale)|default('Author') }}:</strong>
                <span>{{ post.author.fullName }}</span>
            </div>

            <div style="display: grid; grid-template-columns: 150px 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                <strong>{{ 'label.published_at'|trans({}, 'messages', app.request.locale)|default('Published at') }}:</strong>
                <span>{{ post.publishedAt|date('Y-m-d H:i:s') }}</span>
            </div>

            <div style="display: grid; grid-template-columns: 150px 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                <strong>{{ 'label.slug'|trans({}, 'messages', app.request.locale)|default('Slug') }}:</strong>
                <span><code>{{ post.slug }}</code></span>
            </div>

            {% if post.tags|length > 0 %}
                <div style="display: grid; grid-template-columns: 150px 1fr; gap: 1rem;">
                    <strong>{{ 'label.tags'|trans({}, 'messages', app.request.locale)|default('Tags') }}:</strong>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        {% for tag in post.tags %}
                            <span style="padding: 0.25rem 0.75rem; background: #e9ecef; border-radius: 1rem; font-size: 0.875rem;">
                                {{ tag.name }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div style="margin-bottom: 1.5rem;">
            <h3>{{ 'label.summary'|trans({}, 'messages', app.request.locale)|default('Summary') }}</h3>
            <p style="font-style: italic; color: #6c757d;">{{ post.summary }}</p>
        </div>

        <div>
            <h3>{{ 'label.content'|trans({}, 'messages', app.request.locale)|default('Content') }}</h3>
            <div style="line-height: 1.6;">
                {{ post.content|nl2br }}
            </div>
        </div>

        {% if post.comments|length > 0 %}
            <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #dee2e6;">
                <h3>{{ 'label.comments'|trans({}, 'messages', app.request.locale)|default('Comments') }} ({{ post.comments|length }})</h3>
                {% for comment in post.comments %}
                    <div style="margin-top: 1rem; padding: 1rem; background: #f8f9fa; border-radius: 0.25rem;">
                        <div style="margin-bottom: 0.5rem;">
                            <strong>{{ comment.author.fullName }}</strong>
                            <small style="color: #6c757d;"> - {{ comment.publishedAt|date('Y-m-d H:i') }}</small>
                        </div>
                        <p style="margin: 0;">{{ comment.content }}</p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div style="margin-top: 1.5rem;">
        <a href="{{ path('admin_post_index') }}" style="color: #0d6efd; text-decoration: none;">
            ← {{ 'action.back_to_list'|trans({}, 'messages', app.request.locale)|default('Back to post list') }}
        </a>
    </div>
{% endblock %}
