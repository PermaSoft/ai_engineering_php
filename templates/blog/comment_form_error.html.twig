{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <article>
        <h1>{{ post.title }}</h1>

        <p style="font-style: italic; color: #6c757d; margin-bottom: 2rem;">
            {{ post.summary }}
        </p>

        <div style="line-height: 1.6; margin-bottom: 2rem;">
            {{ post.content|nl2br }}
        </div>
    </article>

    <hr style="margin: 2rem 0; border: 0; border-top: 1px solid #dee2e6;">

    {# Display form errors prominently #}
    <div class="alert-danger" style="padding: 1rem; margin-bottom: 1rem; background: #f8d7da; border: 1px solid #842029; border-radius: 0.25rem; color: #842029;">
        <strong>There was a problem with your comment:</strong>
        {{ form_errors(form) }}
    </div>

    {# Re-render the form with user's input #}
    <div style="background: white; padding: 1.5rem; border-radius: 0.25rem; border: 1px solid #dee2e6;">
        <h3 style="margin-top: 0;">Add a comment</h3>

        {{ form_start(form, {
            'action': path('comment_new', {postSlug: post.slug}),
            'attr': {'novalidate': 'novalidate'}
        }) }}
            {{ form_widget(form) }}

            <div style="margin-top: 1rem;">
                <button type="submit" style="padding: 0.5rem 1.5rem; background: #0d6efd; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 1rem;">
                    Publish comment
                </button>
                <a href="{{ path('blog_post', {slug: post.slug}) }}" style="margin-left: 1rem; padding: 0.5rem 1.5rem; background: #6c757d; color: white; text-decoration: none; border-radius: 0.25rem; display: inline-block;">
                    Cancel
                </a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
