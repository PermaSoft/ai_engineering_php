{% extends 'base.html.twig' %}

{% block page_title %}{{ 'title.blog_index'|trans }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ 'title.blog_posts'|trans }}</h1>
    </div>

    {% if tagName is defined and tagName %}
        <div class="alert alert-info">
            {{ 'help.filtered_by_tag'|trans }}: <strong>{{ tagName }}</strong>
        </div>
    {% endif %}

    {% if paginator.results|length > 0 %}
        {% for post in paginator.results %}
            {% include 'blog/_post.html.twig' with {
                post: post,
                show_full_content: false
            } %}
        {% endfor %}

        {# Pagination #}
        {% if paginator.hasToPaginate %}
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    {% if paginator.hasPreviousPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('blog_index_paginated', {page: paginator.previousPage}) }}">
                                {{ 'action.previous'|trans }}
                            </a>
                        </li>
                    {% endif %}

                    <li class="page-item disabled">
                        <span class="page-link">
                            {{ 'help.page'|trans }} {{ paginator.currentPage }} / {{ paginator.lastPage }}
                        </span>
                    </li>

                    {% if paginator.hasNextPage %}
                        <li class="page-item">
                            <a class="page-link" href="{{ path('blog_index_paginated', {page: paginator.nextPage}) }}">
                                {{ 'action.next'|trans }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info">
            {{ 'help.no_posts_found'|trans }}
        </div>
    {% endif %}
{% endblock %}

{% block sidebar %}
    {{ parent() }}

    {# RSS Feed Link #}
    {% include 'blog/_rss.html.twig' %}
{% endblock %}
