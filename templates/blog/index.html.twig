{% extends 'base.html.twig' %}

{% block title %}Blog{% endblock %}

{% block body %}
    <h1>Blog</h1>

    {% if tagName is defined and tagName %}
        <p>Filtered by tag: {{ tagName }}</p>
    {% endif %}

    {% for post in paginator.results %}
        <article style="margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid #dee2e6;">
            <h2>
                <a href="{{ path('blog_post', {slug: post.slug}) }}">{{ post.title }}</a>
            </h2>

            <p style="color: #6c757d; font-size: 0.875rem;">
                By {{ post.author.fullName }}
                on {{ post.publishedAt|date('Y-m-d H:i') }}
            </p>

            <p>{{ post.summary }}</p>

            {% if post.tags|length > 0 %}
                <p>
                    Tags:
                    {% for tag in post.tags %}
                        <a href="{{ path('blog_index', {tag: tag.name}) }}">#{{ tag.name }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </p>
            {% endif %}
        </article>
    {% else %}
        <p>No blog posts found.</p>
    {% endfor %}

    {% if paginator.hasToPaginate %}
        <nav>
            {% if paginator.hasPreviousPage %}
                <a href="{{ path('blog_index_paginated', {page: paginator.previousPage}) }}">Previous</a>
            {% endif %}

            <span>Page {{ paginator.currentPage }} / {{ paginator.lastPage }}</span>

            {% if paginator.hasNextPage %}
                <a href="{{ path('blog_index_paginated', {page: paginator.nextPage}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
