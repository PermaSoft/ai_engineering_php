{% extends 'base.html.twig' %}

{% block title %}{{ 'title.change_password'|trans({}, 'messages', app.request.locale)|default('Change Password') }}{% endblock %}

{% block body %}
    <h1>{{ 'title.change_password'|trans({}, 'messages', app.request.locale)|default('Change Password') }}</h1>

    <div style="background: white; padding: 2rem; border-radius: 0.25rem; box-shadow: 0 0 10px rgba(0,0,0,0.1); max-width: 600px;">
        <div style="padding: 1rem; margin-bottom: 1.5rem; background: #cff4fc; border: 1px solid #087990; border-radius: 0.25rem; color: #055160;">
            <strong>{{ 'help.password_requirements'|trans({}, 'messages', app.request.locale)|default('Password requirements:') }}</strong>
            <ul style="margin: 0.5rem 0 0 1.5rem;">
                <li>{{ 'help.password_min_length'|trans({}, 'messages', app.request.locale)|default('Minimum 6 characters') }}</li>
                <li>{{ 'help.password_must_match'|trans({}, 'messages', app.request.locale)|default('New password and confirmation must match') }}</li>
            </ul>
        </div>

        {{ form_start(form) }}
            {{ form_widget(form) }}

            <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
                <button type="submit" style="padding: 0.5rem 1.5rem; background: #0d6efd; color: white; border: none; border-radius: 0.25rem; cursor: pointer; font-size: 1rem;">
                    {{ 'action.update_password'|trans({}, 'messages', app.request.locale)|default('Update password') }}
                </button>

                <a href="{{ path('user_edit') }}" style="padding: 0.5rem 1.5rem; background: #6c757d; color: white; text-decoration: none; border-radius: 0.25rem; display: inline-block; font-size: 1rem;">
                    {{ 'action.cancel'|trans({}, 'messages', app.request.locale)|default('Cancel') }}
                </a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
